# 复制为 .env 后按需修改（.env 不应提交到 Git）

# 前端 axios 请求基地址。留空则使用当前页面 origin（开发时配合 setupProxy 走 /api）
# REACT_APP_API_BASE_URL=

# 若需直连后端而不走代理，可设为例如：
# REACT_APP_API_BASE_URL=http://127.0.0.1:5000

# 后端使用 Cookie 会话且需跨域携带凭证时设为 true（需后端 CORS 允许 credentials）
# REACT_APP_API_WITH_CREDENTIALS=true

# 仅开发：webpack-dev-server 将 /api 代理到该地址（不要提交真实生产 IP 到仓库）
HTTP_PROXY_TARGET=http://127.0.0.1:5000
